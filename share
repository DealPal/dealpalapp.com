<body>
  <script>
    var ua = navigator.userAgent || navigator.vendor || window.opera;
    if (/android/i.test(ua)) {
      window.location.href = "https://play.google.com/store/apps/details?id=com.dealpal.app";
    } else if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
      window.location.href = "https://apps.apple.com/ca/app/deal-pal/id6757985986";
    } else {
      window.location.href = "https://dealpalapp.com";
    }
  </script>
